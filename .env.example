# --- Backend ---
# Database URL. Use PostgreSQL in production; SQLite for local tests.
# PostgreSQL: postgresql+psycopg://user:password@host:5432/dbname
# SQLite:     sqlite:///./operations.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operations

# JWT secret. MUST be a long random string in production.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS origins (comma-separated).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Outbox background processor.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_MAX_ATTEMPTS=5
# Set to a URL to deliver outbox events via HTTP POST; leave empty for log-only.
OUTBOX_SINK_URL=

# --- Frontend ---
# URL of the FastAPI backend, visible to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8001
